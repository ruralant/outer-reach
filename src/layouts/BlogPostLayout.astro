---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Longform from "./Longform.astro";
import Tag from "../components/Tag.astro";
import { useTranslations, localePath, localeDateString } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
	post: CollectionEntry<"blog">;
	headings?: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, published, updated, author, tags } = post.data;
const lang = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(lang);

const iso = (date: Date) => date.toISOString().slice(0, 10);
---

<Longform
	title={title}
	description={description}
	back={{ href: localePath(lang, "/blog/"), text: t("blog.all") as string }}
	eyebrow={`${t("blog.title")} · ${localeDateString(published, lang)}`}
	headings={headings}
>
	<Fragment slot="meta">
		<div>
			<dt class="eyebrow">{t("blog.published")}</dt>
			<dd><time datetime={iso(published)}>{localeDateString(published, lang)}</time></dd>
		</div>
		{updated && (
			<div>
				<dt class="eyebrow">{t("blog.updated")}</dt>
				<dd><time datetime={iso(updated)}>{localeDateString(updated, lang)}</time></dd>
			</div>
		)}
		{author && (
			<div>
				<dt class="eyebrow">{t("note.author")}</dt>
				<dd>{author}</dd>
			</div>
		)}
		{tags.length > 0 && (
			<div>
				<dt class="eyebrow">{t("garden.filterTags")}</dt>
				<dd class="pills">
					{tags.map((tag) => <Tag label={tag} href={localePath(lang, `/blog/tags/${tag}`)} />)}
				</dd>
			</div>
		)}
	</Fragment>

	<slot />
</Longform>
