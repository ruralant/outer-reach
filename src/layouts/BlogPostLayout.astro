---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { useTranslations, localePath, localeDateString } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, published, updated, author, tags } = post.data;
const lang = (Astro.currentLocale || 'en') as Lang;
const t = useTranslations(lang);

const formattedPublished = localeDateString(published, lang);
const formattedUpdated = updated ? localeDateString(updated, lang) : null;
---

<BaseLayout title={`${title} — ${t('site.title')}`} description={description}>
	<article class="blog-post">
		<nav class="top-nav">
			<a href={localePath(lang, '/blog/')}>{t('nav.backToBlog')}</a>
			<div class="top-nav-right">
				<LanguageSwitcher />
				<ThemeToggle />
			</div>
		</nav>

		<header class="post-header">
			<h1 class="post-title">{title}</h1>
			<p class="post-description">{description}</p>

			<div class="post-meta">
				{author && (
					<span class="meta-item">{t('note.by')} {author}</span>
				)}
				<span class="meta-item">{t('blog.published')} {formattedPublished}</span>
				{formattedUpdated && (
					<span class="meta-item">{t('blog.updated')} {formattedUpdated}</span>
				)}
			</div>

			{tags.length > 0 && (
				<div class="tags">
					{tags.map((tag) => (
						<a href={localePath(lang, `/blog/tags/${tag}`)} class="tag">{tag}</a>
					))}
				</div>
			)}
		</header>

		<div class="post-content">
			<slot />
		</div>

		<footer class="post-footer">
			<div class="footer-nav">
				<a href={localePath(lang, '/blog/')}>{t('nav.backToBlogLong')}</a>
				<a href={localePath(lang, '/rss.xml')} class="rss-link" aria-label="RSS Feed">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 11a9 9 0 0 1 9 9"></path>
						<path d="M4 4a16 16 0 0 1 16 16"></path>
						<circle cx="5" cy="19" r="1"></circle>
					</svg>
				</a>
			</div>
		</footer>
	</article>
</BaseLayout>

<style>
	.blog-post {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.top-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0 2rem;
	}

	.top-nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.top-nav a {
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.top-nav a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.post-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.post-title {
		font-size: 2.4rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem 0;
		line-height: 1.2;
		color: var(--color-text-primary);
	}

	.post-description {
		font-size: 1.1rem;
		color: var(--color-text-secondary);
		margin: 0 0 1rem 0;
		font-style: italic;
		line-height: 1.5;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		margin-bottom: 0.75rem;
		opacity: 0.8;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.tag::before {
		content: '#';
		opacity: 0.5;
	}

	.tag:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	/* --- Post content (prose) --- */
	.post-content {
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.post-content :global(h2) {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 2.5rem 0 1rem 0;
		color: var(--color-text-primary);
		letter-spacing: -0.01em;
	}

	.post-content :global(h3) {
		font-size: 1.15rem;
		font-weight: 600;
		margin: 2rem 0 0.75rem 0;
		color: var(--color-text-primary);
	}

	.post-content :global(p) {
		margin: 0 0 1rem 0;
		color: var(--color-text-primary);
		line-height: 1.8;
	}

	.post-content :global(blockquote) {
		border-left: 2px solid var(--color-accent);
		padding-left: 1.25rem;
		margin: 1.5rem 0;
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.post-content :global(code) {
		background-color: var(--color-background-secondary);
		border: 1px solid var(--color-border);
		padding: 0.1rem 0.35rem;
		border-radius: 3px;
		font-family: 'Courier New', monospace;
		font-size: 0.9em;
		color: var(--color-text-primary);
	}

	.post-content :global(pre) {
		background-color: var(--color-background-secondary);
		border: 1px solid var(--color-border);
		padding: 1rem;
		border-radius: 4px;
		overflow-x: auto;
		margin: 1.5rem 0;
	}

	.post-content :global(pre code) {
		background-color: transparent;
		border: none;
		padding: 0;
		border-radius: 0;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		margin: 0 0 1rem 0;
		padding-left: 1.25rem;
	}

	.post-content :global(ul) {
		list-style: none;
	}

	.post-content :global(ul > li) {
		position: relative;
		padding-left: 0.75rem;
	}

	.post-content :global(ul > li::before) {
		content: '—';
		position: absolute;
		left: -1rem;
		color: var(--color-text-secondary);
		opacity: 0.5;
	}

	.post-content :global(li) {
		margin: 0.35rem 0;
		color: var(--color-text-primary);
		line-height: 1.7;
	}

	.post-content :global(a) {
		color: var(--color-accent);
		text-decoration: none;
	}

	.post-content :global(a:hover) {
		text-decoration: underline;
	}

	.post-content :global(hr) {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: 2rem 0;
	}

	.post-content :global(strong) {
		font-weight: 600;
	}

	/* --- Footer --- */
	.post-footer {
		margin-top: 3rem;
	}

	.footer-nav {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.footer-nav a {
		font-size: 0.9rem;
		color: var(--color-accent);
		text-decoration: none;
	}

	.footer-nav a:hover {
		text-decoration: underline;
	}

	.rss-link {
		display: inline-flex;
		color: var(--color-text-secondary);
		opacity: 0.5;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	.rss-link:hover {
		opacity: 1;
		color: var(--color-accent);
		text-decoration: none;
	}

	@media (max-width: 640px) {
		.blog-post {
			padding: 1.5rem 1rem 3rem;
		}

		.post-title {
			font-size: 1.75rem;
		}

		.post-meta {
			gap: 0.75rem;
			font-size: 0.8rem;
		}
	}
</style>
