---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Backlinks from '../components/Backlinks.astro';
import RelatedNotes from '../components/RelatedNotes.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import type { GardenNote } from '../lib/garden';
import { useTranslations, localePath, localeDateString, slugFromNoteId } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	note: CollectionEntry<'garden'>;
	backlinks: GardenNote[];
	relatedNotes: GardenNote[];
}

const { note, backlinks, relatedNotes } = Astro.props;
const { title, description, created, updated, author, tags, status } = note.data;
const lang = (Astro.currentLocale || 'en') as Lang;
const t = useTranslations(lang);

const formattedCreated = localeDateString(created, lang);
const formattedUpdated = updated ? localeDateString(updated, lang) : null;
---

<BaseLayout title={`${title} — ${t('site.title')}`} description={description}>
	<article class="garden-note">
		<nav class="top-nav">
			<a href={localePath(lang, '/garden/')}>{t('nav.backToGarden')}</a>
			<div class="top-nav-right">
				<LanguageSwitcher />
				<a href={localePath(lang, '/rss.xml')}>{t('nav.rss')}</a>
			</div>
		</nav>

		<header class="note-header">
			<div class="note-status-row">
				<StatusBadge status={status} />
			</div>
			<h1 class="note-title">{title}</h1>
			<p class="note-description">{description}</p>

			<div class="note-meta">
				{author && (
					<span class="meta-item">{t('note.by')} {author}</span>
				)}
				<span class="meta-item">{t('note.planted')} {formattedCreated}</span>
				{formattedUpdated && (
					<span class="meta-item">{t('note.tended')} {formattedUpdated}</span>
				)}
			</div>

			{tags.length > 0 && (
				<div class="tags">
					{tags.map((tag) => (
						<a href={localePath(lang, `/garden/tags/${tag}`)} class="tag">{tag}</a>
					))}
				</div>
			)}
		</header>

		<div class="note-content">
			<slot />
		</div>

		<footer class="note-footer">
			<RelatedNotes notes={relatedNotes} />
			<Backlinks backlinks={backlinks} />
			<div class="footer-nav">
				<a href={localePath(lang, '/garden/')}>{t('nav.backToGardenLong')}</a>
			</div>
		</footer>
	</article>
</BaseLayout>

<style>
	.garden-note {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.top-nav {
		display: flex;
		justify-content: space-between;
		padding: 0.5rem 0 2rem;
	}

	.top-nav-right {
		display: flex;
		gap: 1.5rem;
	}

	.top-nav a {
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.top-nav a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.note-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.note-status-row {
		margin-bottom: 0.75rem;
	}

	.note-title {
		font-size: 2.4rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem 0;
		line-height: 1.2;
		color: var(--color-text-primary);
	}

	.note-description {
		font-size: 1.1rem;
		color: var(--color-text-secondary);
		margin: 0 0 1rem 0;
		font-style: italic;
		line-height: 1.5;
	}

	.note-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		margin-bottom: 0.75rem;
		opacity: 0.8;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.tag::before {
		content: '#';
		opacity: 0.5;
	}

	.tag:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	/* --- Note content (prose) --- */
	.note-content {
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.note-content :global(h2) {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 2.5rem 0 1rem 0;
		color: var(--color-text-primary);
		letter-spacing: -0.01em;
	}

	.note-content :global(h3) {
		font-size: 1.15rem;
		font-weight: 600;
		margin: 2rem 0 0.75rem 0;
		color: var(--color-text-primary);
	}

	.note-content :global(p) {
		margin: 0 0 1rem 0;
		color: var(--color-text-primary);
		line-height: 1.8;
	}

	.note-content :global(blockquote) {
		border-left: 2px solid var(--color-accent);
		padding-left: 1.25rem;
		margin: 1.5rem 0;
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.note-content :global(code) {
		background-color: var(--color-background-secondary);
		border: 1px solid var(--color-border);
		padding: 0.1rem 0.35rem;
		border-radius: 3px;
		font-family: 'Courier New', monospace;
		font-size: 0.9em;
		color: var(--color-text-primary);
	}

	.note-content :global(pre) {
		background-color: var(--color-background-secondary);
		border: 1px solid var(--color-border);
		padding: 1rem;
		border-radius: 4px;
		overflow-x: auto;
		margin: 1.5rem 0;
	}

	.note-content :global(pre code) {
		background-color: transparent;
		border: none;
		padding: 0;
		border-radius: 0;
	}

	.note-content :global(ul),
	.note-content :global(ol) {
		margin: 0 0 1rem 0;
		padding-left: 1.25rem;
	}

	.note-content :global(ul) {
		list-style: none;
	}

	.note-content :global(ul > li) {
		position: relative;
		padding-left: 0.75rem;
	}

	.note-content :global(ul > li::before) {
		content: '—';
		position: absolute;
		left: -1rem;
		color: var(--color-text-secondary);
		opacity: 0.5;
	}

	.note-content :global(li) {
		margin: 0.35rem 0;
		color: var(--color-text-primary);
		line-height: 1.7;
	}

	.note-content :global(a) {
		color: var(--color-accent);
		text-decoration: none;
	}

	.note-content :global(a:hover) {
		text-decoration: underline;
	}

	.note-content :global(a.wiki-link) {
		color: var(--color-accent);
		border-bottom: 1px dashed var(--color-accent);
		text-decoration: none;
	}

	.note-content :global(a.wiki-link:hover) {
		border-bottom-style: solid;
		text-decoration: none;
	}

	.note-content :global(hr) {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: 2rem 0;
	}

	.note-content :global(strong) {
		font-weight: 600;
	}

	/* --- Footer --- */
	.note-footer {
		margin-top: 3rem;
	}

	.footer-nav {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.footer-nav a {
		font-size: 0.9rem;
		color: var(--color-accent);
		text-decoration: none;
	}

	.footer-nav a:hover {
		text-decoration: underline;
	}

	@media (max-width: 640px) {
		.garden-note {
			padding: 1.5rem 1rem 3rem;
		}

		.note-title {
			font-size: 1.75rem;
		}

		.note-meta {
			gap: 0.75rem;
			font-size: 0.8rem;
		}
	}
</style>
