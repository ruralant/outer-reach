---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Longform from "./Longform.astro";
import Tag from "../components/Tag.astro";
import StatusBadge from "../components/StatusBadge.astro";
import NoteLinks from "../components/NoteLinks.astro";
import type { GardenNote } from "../lib/garden";
import { useTranslations, localePath, localeDateString } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
	note: CollectionEntry<"garden">;
	backlinks: GardenNote[];
	relatedNotes: GardenNote[];
	headings?: MarkdownHeading[];
}

const { note, backlinks, relatedNotes, headings } = Astro.props;
const { title, description, created, updated, author, tags, status } = note.data;
const lang = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(lang);

const iso = (date: Date) => date.toISOString().slice(0, 10);
---

<Longform
	title={title}
	description={description}
	back={{ href: localePath(lang, "/garden/"), text: t("garden.all") as string }}
	eyebrow={`${t(`status.${status}`)} · ${t("note.planted")} ${localeDateString(created, lang)}`}
	headings={headings}
>
	<Fragment slot="meta">
		<div>
			<dt class="eyebrow">{t("garden.filterStatus")}</dt>
			<dd class="pills"><StatusBadge status={status} link /></dd>
		</div>
		<div>
			<dt class="eyebrow">{t("note.planted")}</dt>
			<dd><time datetime={iso(created)}>{localeDateString(created, lang)}</time></dd>
		</div>
		{updated && (
			<div>
				<dt class="eyebrow">{t("note.tended")}</dt>
				<dd><time datetime={iso(updated)}>{localeDateString(updated, lang)}</time></dd>
			</div>
		)}
		{author && (
			<div>
				<dt class="eyebrow">{t("note.author")}</dt>
				<dd>{author}</dd>
			</div>
		)}
		{tags.length > 0 && (
			<div>
				<dt class="eyebrow">{t("garden.filterTags")}</dt>
				<dd class="pills">
					{tags.map((tag) => <Tag label={tag} href={localePath(lang, `/garden/tags/${tag}`)} />)}
				</dd>
			</div>
		)}
	</Fragment>

	<slot />

	<Fragment slot="appendix">
		<NoteLinks title={t("note.relatedNotes") as string} notes={relatedNotes} />
		<NoteLinks title={t("note.linkedFrom") as string} notes={backlinks} />
	</Fragment>
</Longform>
