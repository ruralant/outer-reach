---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getNotesForLocale } from '../lib/garden';
import { getSortedPostsForLocale } from '../lib/blog';
import { getPhotos } from '../lib/photos';
import { useTranslations, localePath, localeDateShort, gardenNotePath, slugFromNoteId } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/home.css';

const lang = (Astro.currentLocale || 'en') as Lang;
const t = useTranslations(lang);

const allNotes = await getNotesForLocale(lang);
const latestNotes = allNotes
	.sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf())
	.slice(0, 3);

const latestPosts = (await getSortedPostsForLocale(lang)).slice(0, 3);
const latestPhotos = await getPhotos({ limit: 3, lite: true });
---

<BaseLayout title={t('site.title') as string} description={t('site.tagline') as string}>
	<div class="manifesto">
		<TopNav lang={lang} currentPath={Astro.url.pathname} />

		<header class="hero">
			<h1>{t('site.title')}</h1>
			<div class="hero-subtitle-row">
				<p class="hero-lead">{t('site.tagline')}</p>
				<a class="manifesto-btn" href={localePath(lang, '/manifesto/')}>{t('nav.manifesto')}</a>
			</div>
		</header>

		{latestPosts.length > 0 && (
			<section class="recent-section">
				<h2>{t('blog.recentPosts')}</h2>
				<div class="posts-list">
					{latestPosts.map((post) => (
						<a href={localePath(lang, `/blog/${slugFromNoteId(post.id)}`)} class="post-item">
							<span class="post-item-title">{post.data.title}</span>
							<p class="post-item-description">{post.data.description}</p>
							<time class="post-item-date">
								{localeDateShort(post.data.published, lang)}
							</time>
						</a>
					))}
				</div>
			</section>
		)}

		{latestPhotos.length > 0 && (
			<section class="recent-section">
				<h2>{t('home.recentPhotos')}</h2>
				<div class="cards-grid">
					{latestPhotos.map((photo, i) => (
						<a href={localePath(lang, `/photos/${photo.slug}`)} class="photo-card">
							<Image
								src={photo.image}
								alt={photo.slug}
								width={400}
								height={400}
								widths={[220, 400, 760]}
								sizes="(max-width: 640px) 100vw, 220px"
								format="webp"
								loading={i === 0 ? 'eager' : 'lazy'}
								fetchpriority={i === 0 ? 'high' : 'auto'}
								decoding="async"
							/>
						</a>
					))}
				</div>
			</section>
		)}

		{latestNotes.length > 0 && (
			<section class="recent-notes">
				<h2>{t('garden.recentNotes')}</h2>
				<div class="notes-list">
					{latestNotes.map((note) => (
						<a href={gardenNotePath(lang, slugFromNoteId(note.id))} class="note-link">
							<article class="note-item">
								<div class="note-item-header">
									<span class="note-item-title">{note.data.title}</span>
									<StatusBadge status={note.data.status} size="sm" />
								</div>
								<p class="note-item-description">{note.data.description}</p>
								<time class="note-item-date">
									{localeDateShort(note.data.created, lang)}
								</time>
							</article>
						</a>
					))}
				</div>
				<div class="garden-cta">
					<a href={localePath(lang, '/garden/')}>{t('nav.exploreGarden')}</a>
				</div>
			</section>
		)}

		<Footer lang={lang} />
	</div>
</BaseLayout>


