---
import TaggedView from '../../../components/views/TaggedView.astro';
import { getSortedPostsForLocale, getAllBlogTags } from '../../../lib/blog';
import { postRow } from '../../../lib/rows';

export async function getStaticPaths() {
	const posts = await getSortedPostsForLocale('en');

	return getAllBlogTags(posts).map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<TaggedView lang="en" collection="blog" tag={tag} rows={posts.map((post) => postRow(post, 'en'))} />
