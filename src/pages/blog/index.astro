---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getSortedPosts, getAllBlogTags } from '../../lib/blog';
import { useTranslations, localePath, localeDateShort } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale || 'en') as Lang;
const t = useTranslations(lang);

const posts = await getSortedPosts();
const tags = getAllBlogTags(posts);
---

<BaseLayout title={`${t('blog.title')} — ${t('site.title')}`} description={t('blog.subtitle') as string}>
	<div class="blog-page">
		<nav class="top-nav">
			<a href={localePath(lang, '/')}>{t('nav.home')}</a>
			<div class="top-nav-right">
				<LanguageSwitcher />
				<ThemeToggle />
			</div>
		</nav>

		<header class="blog-header">
			<h1>{t('blog.title')}</h1>
			<p class="subtitle">{t('blog.subtitle')}</p>
		</header>

		{tags.length > 0 && (
			<nav class="filter-nav">
				<div class="filter-row">
					<span class="filter-label">{t('garden.filterTags')}</span>
					<div class="filter-links">
						{tags.map((tag) => {
							const count = posts.filter((p) => p.data.tags.includes(tag)).length;
							return (
								<a href={localePath(lang, `/blog/tags/${tag}`)} class="filter-chip">
									{tag} <span class="chip-count">({count})</span>
								</a>
							);
						})}
					</div>
				</div>
			</nav>
		)}

		{posts.length === 0 ? (
			<p class="empty">{t('blog.noPosts')}</p>
		) : (
			<div class="posts-list">
				{posts.map((post) => (
					<a href={localePath(lang, `/blog/${post.id}`)} class="post-link">
						<article class="post-item">
							<div class="post-item-header">
								<span class="post-item-title">{post.data.title}</span>
							</div>
							<p class="post-item-description">{post.data.description}</p>
							<div class="post-item-footer">
								<time class="post-item-date">
									{localeDateShort(post.data.published, lang)}
								</time>
								{post.data.tags.length > 0 && (
									<span class="post-item-tags">
										{post.data.tags.join(' · ')}
									</span>
								)}
							</div>
						</article>
					</a>
				))}
			</div>
		)}

		<footer class="page-footer">
			<a href={localePath(lang, '/rss.xml')} class="rss-link" aria-label="RSS Feed">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
			</a>
			<p>{t('site.footer')}</p>
		</footer>
	</div>
</BaseLayout>

<style>
	.blog-page {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.top-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.5rem 0 2rem;
	}

	.top-nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.top-nav a {
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.top-nav a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.blog-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.blog-header h1 {
		font-size: 2.8rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.75rem 0;
		color: var(--color-text-primary);
		line-height: 1.15;
	}

	.subtitle {
		font-size: 1.05rem;
		color: var(--color-text-secondary);
		margin: 0;
		line-height: 1.6;
	}

	/* --- Filter nav --- */
	.filter-nav {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.filter-row {
		margin-bottom: 0.75rem;
	}

	.filter-row:last-child {
		margin-bottom: 0;
	}

	.filter-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-secondary);
		margin-right: 0.75rem;
	}

	.filter-links {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.filter-chip {
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		text-decoration: none;
		padding: 0.15rem 0;
		transition: color 0.2s ease;
	}

	.filter-chip:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.filter-chip + .filter-chip::before {
		content: '·';
		margin-right: 0.4rem;
		color: var(--color-border);
	}

	.chip-count {
		font-size: 0.75rem;
		opacity: 0.6;
	}

	/* --- Posts list --- */
	.empty {
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.post-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.post-link:hover {
		text-decoration: none;
	}

	.post-item {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--color-border);
		transition: opacity 0.2s ease;
	}

	.post-link:first-child .post-item {
		padding-top: 0;
	}

	.post-link:hover .post-item {
		opacity: 0.7;
	}

	.post-item-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.3rem;
		flex-wrap: wrap;
	}

	.post-item-title {
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--color-text-primary);
	}

	.post-item-description {
		font-size: 0.95rem;
		color: var(--color-text-secondary);
		margin: 0;
		line-height: 1.5;
	}

	.post-item-footer {
		display: flex;
		gap: 1rem;
		margin-top: 0.35rem;
		align-items: center;
	}

	.post-item-date {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.6;
	}

	.post-item-tags {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.5;
	}

	/* --- Footer --- */
	.page-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
		text-align: center;
	}

	.rss-link {
		display: inline-flex;
		color: var(--color-text-secondary);
		opacity: 0.5;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	.rss-link:hover {
		opacity: 1;
		color: var(--color-accent);
		text-decoration: none;
	}

	.page-footer p {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.6;
		margin-top: 0.75rem;
	}

	@media (max-width: 640px) {
		.blog-page {
			padding: 1.5rem 1rem 3rem;
		}

		.blog-header h1 {
			font-size: 2rem;
		}
	}
</style>
