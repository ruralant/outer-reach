---
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getSortedPostsForLocale } from '../../lib/blog';
import { slugFromNoteId } from '../../i18n/utils';

export async function getStaticPaths() {
	const posts = await getSortedPostsForLocale('en');

	return posts.map((post) => ({
		params: { slug: slugFromNoteId(post.id) },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout post={post} headings={headings}>
	<Content />
</BlogPostLayout>
