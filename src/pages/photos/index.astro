---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { getPhotos } from '../../lib/photos';
import type { Lang } from '../../i18n/ui';

const photos = await getPhotos();
const lang = (Astro.currentLocale || 'en') as Lang;
---

<BaseLayout title="Photos — Outer Reach" description="A collection of photographs.">
	<div class="photos-page">
		<TopNav lang={lang} currentPath={Astro.url.pathname} />

		<header class="photos-header">
			<h1>Photos</h1>
		</header>

		{photos.length === 0 ? (
			<p class="empty">No photos yet.</p>
		) : (
			<div class="photos-grid">
				{photos.map((photo, i) => (
					<a href={`/photos/${photo.slug}`} class="photo-card">
						<Image
							src={photo.image}
							alt={photo.slug}
							width={320}
							height={320}
							widths={[320, 640]}
							sizes="(max-width: 500px) 100vw, 310px"
							format="webp"
							loading={i === 0 ? 'eager' : 'lazy'}
							fetchpriority={i === 0 ? 'high' : 'auto'}
							decoding="async"
						/>
					</a>
				))}
			</div>
		)}

		<Footer lang={lang} />
	</div>
</BaseLayout>

<style>
	.photos-page {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.photos-header {
		margin-bottom: 2.5rem;
	}

	.photos-header h1 {
		font-size: 1.8rem;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0;
	}

	.empty {
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.photos-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.photo-card {
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 6px;
		background: var(--color-background-secondary);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.photo-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px var(--color-card-shadow);
	}

	.photo-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.photo-card:hover img {
		transform: scale(1.03);
	}

	@media (max-width: 500px) {
		.photos-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
