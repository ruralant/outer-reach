---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { getPhotos } from '../../lib/photos';
import type { Photo } from '../../lib/photos';

export async function getStaticPaths() {
	const photos = await getPhotos();
	return photos.map((photo) => ({
		params: { slug: photo.slug },
		props: { photo },
	}));
}

interface Props {
	photo: Photo;
}

const { photo } = Astro.props;
const { exif } = photo;

const formattedDate = exif.date
	? exif.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
	: undefined;
---

<BaseLayout title={`${photo.slug} — Photos`} description={`Photo: ${photo.filename}`}>
	<div class="photo-detail">
		<nav class="top-nav">
			<a href="/photos/">← Photos</a>
			<div class="top-nav-right">
				<ThemeToggle />
			</div>
		</nav>

		<div class="photo-container">
			<img
				src={photo.src}
				alt={photo.filename}
				loading="eager"
				decoding="async"
			/>
		</div>

		{(exif.camera || exif.lens || exif.aperture || exif.shutterSpeed || exif.iso || exif.focalLength || formattedDate) && (
			<div class="exif-bar">
				{exif.camera && (
					<div class="exif-item">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
							<circle cx="12" cy="13" r="3"/>
						</svg>
						<span>{exif.camera}</span>
					</div>
				)}

				{exif.lens && (
					<div class="exif-item">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<circle cx="12" cy="12" r="6"/>
							<circle cx="12" cy="12" r="2"/>
						</svg>
						<span>{exif.lens}</span>
					</div>
				)}

				{exif.focalLength && (
					<div class="exif-item">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<line x1="22" y1="12" x2="18" y2="12"/>
							<line x1="6" y1="12" x2="2" y2="12"/>
							<line x1="12" y1="6" x2="12" y2="2"/>
							<line x1="12" y1="22" x2="12" y2="18"/>
						</svg>
						<span>{exif.focalLength}</span>
					</div>
				)}

				{exif.aperture && (
					<div class="exif-item">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<line x1="14.31" y1="8" x2="20.05" y2="17.94"/>
							<line x1="9.69" y1="8" x2="21.17" y2="8"/>
							<line x1="7.38" y1="12" x2="13.12" y2="2.06"/>
							<line x1="9.69" y1="16" x2="3.95" y2="6.06"/>
							<line x1="14.31" y1="16" x2="2.83" y2="16"/>
							<line x1="16.62" y1="12" x2="10.88" y2="21.94"/>
						</svg>
						<span>{exif.aperture}</span>
					</div>
				)}

				{exif.shutterSpeed && (
					<div class="exif-item">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<polyline points="12 6 12 12 16 14"/>
						</svg>
						<span>{exif.shutterSpeed}</span>
					</div>
				)}

				{exif.iso && (
					<div class="exif-item">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
						</svg>
						<span>ISO {exif.iso}</span>
					</div>
				)}

				{formattedDate && (
					<div class="exif-item">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
							<line x1="16" y1="2" x2="16" y2="6"/>
							<line x1="8" y1="2" x2="8" y2="6"/>
							<line x1="3" y1="10" x2="21" y2="10"/>
						</svg>
						<span>{formattedDate}</span>
					</div>
				)}
			</div>
		)}

		<footer class="site-footer">
			<p>Outer Reach</p>
		</footer>
	</div>
</BaseLayout>

<style>
	.photo-detail {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.top-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
		font-size: 0.9rem;
	}

	.top-nav a {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.top-nav a:hover {
		color: var(--color-accent);
	}

	.top-nav-right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.photo-container {
		margin-bottom: 2rem;
		border-radius: 8px;
		overflow: hidden;
		background: var(--color-background-secondary);
		line-height: 0;
	}

	.photo-container img {
		width: 100%;
		height: auto;
		display: block;
	}

	.exif-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem 2rem;
		padding: 1.25rem 1.5rem;
		background: var(--color-card-background);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		font-size: 0.85rem;
		color: var(--color-text-secondary);
	}

	.exif-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		white-space: nowrap;
	}

	.exif-item svg {
		flex-shrink: 0;
		color: var(--color-accent);
	}

	.exif-item span {
		color: var(--color-text-primary);
		font-weight: 500;
	}

	.site-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.8rem;
		color: var(--color-text-secondary);
	}

	@media (max-width: 500px) {
		.exif-bar {
			gap: 1rem 1.5rem;
			padding: 1rem;
		}
	}
</style>
