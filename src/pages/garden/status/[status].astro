---
import GardenStatusView from '../../../components/views/GardenStatusView.astro';
import { getNotesForLocale, ALL_STATUSES, type NoteStatus } from '../../../lib/garden';

export async function getStaticPaths() {
	const allNotes = await getNotesForLocale('en');
	const counts = Object.fromEntries(
		ALL_STATUSES.map((s) => [s, allNotes.filter((n) => n.data.status === s).length]),
	) as Record<NoteStatus, number>;

	return ALL_STATUSES.map((status) => ({
		params: { status },
		props: {
			status,
			counts,
			notes: allNotes
				.filter((n) => n.data.status === status)
				.sort((a, b) => a.data.title.localeCompare(b.data.title)),
		},
	}));
}

const { status, notes, counts } = Astro.props;
---

<GardenStatusView lang="en" status={status} notes={notes} counts={counts} />
