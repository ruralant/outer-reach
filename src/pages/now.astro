---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/now.css';
import NowContent from '../content/now/en.md';

const lang = (Astro.currentLocale || 'en') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={`${t('now.title')} — ${t('site.title')}`}>
	<article class="now-page">
		<TopNav lang={lang} currentPath={Astro.url.pathname} />

		<div class="now-meta">
			<span>{t('now.lastUpdated')}: March 2026</span>
		</div>

		<div class="now-content">
			<NowContent />
		</div>

		<Footer lang={lang} />
	</article>
</BaseLayout>


