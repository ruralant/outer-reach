---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TopNav from '../../../../components/TopNav.astro';
import Footer from '../../../../components/Footer.astro';
import { getNotesForLocale } from '../../../../lib/garden';
import { useTranslations, localeDateShort, gardenNotePath, slugFromNoteId } from '../../../../i18n/utils';
import type { Lang } from '../../../../i18n/ui';
import '../../../../styles/garden-tag.css';

export async function getStaticPaths() {
	const allNotes = await getNotesForLocale('it');

	const tagSet = new Set<string>();
	for (const note of allNotes) {
		for (const tag of note.data.tags) {
			tagSet.add(tag);
		}
	}

	return Array.from(tagSet).map((tag) => ({
		params: { tag },
		props: {
			tag,
			notes: allNotes
				.filter((n) => n.data.tags.includes(tag))
				.sort((a, b) => a.data.title.localeCompare(b.data.title)),
		},
	}));
}

const { tag, notes } = Astro.props;
const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={`#${tag} — ${t('site.title')}`} description={`${t('note.notes')} ${t('garden.withThisTag')} "${tag}"`}>
	<div class="container">
		<TopNav lang={lang} currentPath={Astro.url.pathname} />

		<header class="tag-header">
			<h1>#{tag}</h1>
			<p class="subtitle">{notes.length} {notes.length === 1 ? t('note.note') : t('note.notes')} {t('garden.withThisTag')}</p>
		</header>

		<div class="notes-list">
			{notes.map((note) => (
				<article class="note-row">
					<a href={gardenNotePath(lang, slugFromNoteId(note.id))} class="note-title">{note.data.title}</a>
					<p class="note-desc">{note.data.description}</p>
					<span class="note-date">
						{localeDateShort(note.data.created, lang)}
					</span>
				</article>
			))}
		</div>

		<Footer lang={lang} />
	</div>
</BaseLayout>


