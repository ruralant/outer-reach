---
import TaggedView from '../../../../components/views/TaggedView.astro';
import { getNotesForLocale, getAllTags } from '../../../../lib/garden';
import { noteRow } from '../../../../lib/rows';

export async function getStaticPaths() {
	const notes = await getNotesForLocale('it');

	return getAllTags(notes).map((tag) => ({
		params: { tag },
		props: {
			tag,
			notes: notes
				.filter((n) => n.data.tags.includes(tag))
				.sort((a, b) => a.data.title.localeCompare(b.data.title)),
		},
	}));
}

const { tag, notes } = Astro.props;
---

<TaggedView lang="it" collection="garden" tag={tag} rows={notes.map((note) => noteRow(note, 'it'))} />
