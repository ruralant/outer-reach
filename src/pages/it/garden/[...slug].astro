---
import { render } from 'astro:content';
import GardenNoteLayout from '../../../layouts/GardenNoteLayout.astro';
import { getNotesForLocale, getBacklinks, getRelatedNotes } from '../../../lib/garden';
import { useTranslations, slugFromNoteId } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import '../../../styles/garden-note.css';

export async function getStaticPaths() {
	const allNotes = await getNotesForLocale('it');

	return allNotes.map((note) => ({
		params: { slug: slugFromNoteId(note.id) },
		props: {
			note,
			backlinks: getBacklinks(note.id, allNotes),
			relatedNotes: getRelatedNotes(note, allNotes),
		},
	}));
}

const { note, backlinks, relatedNotes } = Astro.props;
const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);
const { Content, headings } = await render(note);
---

<GardenNoteLayout note={note} backlinks={backlinks} relatedNotes={relatedNotes}>
	{headings.length > 2 && (
		<details class="toc">
			<summary>{t('note.contents')}</summary>
			<ul>
				{headings.map((heading) => (
					<li style={{ marginLeft: `${(heading.depth - 2) * 1}rem` }}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))}
			</ul>
		</details>
	)}
	<Content />
</GardenNoteLayout>


