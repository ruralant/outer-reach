---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { useTranslations, localePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import '../../styles/now.css';
import NowContent from '../../content/now/it.md';

const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={`${t('now.title')} — ${t('site.title')}`}>
	<article class="now-page">
		<nav class="top-nav">
			<a href={localePath(lang, '/')}>{t('nav.home')}</a>
			<div class="top-nav-right">
				<LanguageSwitcher />
				<ThemeToggle />
			</div>
		</nav>

		<div class="now-meta">
			<span>{t('now.lastUpdated')}: Marzo 2026</span>
		</div>

		<div class="now-content">
			<NowContent />
		</div>

		<footer class="now-footer">
			<a href={localePath(lang, '/')}>← {t('nav.home')}</a>
		</footer>
	</article>
</BaseLayout>


