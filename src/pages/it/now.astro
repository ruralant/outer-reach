---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { useTranslations, localePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import NowContent from '../../content/now/it.md';

const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={`${t('now.title')} — ${t('site.title')}`}>
	<article class="now-page">
		<nav class="top-nav">
			<a href={localePath(lang, '/')}>{t('nav.home')}</a>
			<div class="top-nav-right">
				<LanguageSwitcher />
				<ThemeToggle />
			</div>
		</nav>

		<div class="now-meta">
			<span>{t('now.lastUpdated')}: Marzo 2026</span>
		</div>

		<div class="now-content">
			<NowContent />
		</div>

		<footer class="now-footer">
			<a href={localePath(lang, '/')}>← {t('nav.home')}</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.now-page {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.top-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0 2rem;
	}

	.top-nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.top-nav a {
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.top-nav a:hover {
		color: var(--color-accent);
	}

	.now-meta {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.7;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
		text-align: center;
	}

	/* --- Prose styling --- */
	.now-content {
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.now-content :global(h1) {
		font-size: 2.4rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem 0;
		line-height: 1.2;
		color: var(--color-text-primary);
		text-align: center;
	}

	.now-content :global(h1 + h2) {
		text-align: center;
		margin: 0 0 2.5rem 0;
		font-weight: 400;
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.now-content :global(h2) {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 2.5rem 0 1rem 0;
		color: var(--color-text-primary);
		letter-spacing: -0.01em;
	}

	.now-content :global(h3) {
		font-size: 1.15rem;
		font-weight: 600;
		margin: 2rem 0 0.75rem 0;
		color: var(--color-text-primary);
	}

	.now-content :global(p) {
		margin: 0 0 1rem 0;
		color: var(--color-text-primary);
		line-height: 1.8;
	}

	.now-content :global(ul),
	.now-content :global(ol) {
		margin: 0 0 1rem 0;
		padding-left: 1.25rem;
	}

	.now-content :global(ul) {
		list-style: none;
	}

	.now-content :global(ul > li) {
		position: relative;
		padding-left: 0.75rem;
	}

	.now-content :global(ul > li::before) {
		content: '—';
		position: absolute;
		left: -1rem;
		color: var(--color-text-secondary);
		opacity: 0.5;
	}

	.now-content :global(li) {
		margin: 0.35rem 0;
		color: var(--color-text-primary);
		line-height: 1.7;
	}

	.now-content :global(a) {
		color: var(--color-accent);
		text-decoration: none;
	}

	.now-content :global(a:hover) {
		text-decoration: underline;
	}

	.now-content :global(hr) {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: 2rem 0;
	}

	.now-content :global(em) {
		font-style: italic;
	}

	/* --- Footer --- */
	.now-footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.now-footer a {
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.now-footer a:hover {
		color: var(--color-accent);
	}
</style>
