---
/**
 * Italian homepage — re-uses the same layout and logic as the root index.
 * Astro.currentLocale is automatically set to "it" because this page
 * lives under src/pages/it/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getNotesForLocale } from '../../lib/garden';
import { useTranslations, localePath, localeDateShort, gardenNotePath, slugFromNoteId } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import '../../styles/home.css';

const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);

const allNotes = await getNotesForLocale(lang);
const latestNotes = allNotes
	.sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf())
	.slice(0, 3);
---

<BaseLayout title={t('site.title') as string} description={t('site.tagline') as string}>
	<div class="manifesto">
		<nav class="top-nav">
			<div class="top-nav-left">
				<a href={localePath(lang, '/blog/')}>{t('nav.blog')}</a>
				<a href={localePath(lang, '/now/')}>{t('nav.now')}</a>
				<a href="/photos/">{t('nav.photos')}</a>
				<a href={localePath(lang, '/garden/')}>{t('nav.garden')}</a>
			</div>
			<div class="top-nav-right">
				<LanguageSwitcher />
				<ThemeToggle />
			</div>
		</nav>

		<header class="hero">
			<h1>{t('site.title')}</h1>
			<p class="hero-lead">{t('site.tagline')}</p>
		</header>

		<div class="prose">
			<p>{t('home.intro')}</p>
			<p>{t('home.intro2')}</p>

			<h2>{t('home.whatTitle')}</h2>
			<p>{t('home.what1')}</p>
			<p>{t('home.what2')}</p>
			<p>{t('home.what3')}</p>
			<p class="pull">{t('home.whatPull')}</p>

			<h2>{t('home.swTitle')} <span class="aside">{t('home.swAside')}</span></h2>
			<p>{t('home.sw1')}</p>
			<p>{t('home.sw2')}</p>
			<p>{t('home.sw3')}</p>
			<p>{t('home.sw4')}</p>
			<p>{t('home.sw5')}</p>

			<h2>{t('home.coreTitle')}</h2>
			<p>{t('home.core1')}</p>
			<p>{t('home.core2')}</p>
			<ul>
				{(t('home.coreList') as unknown as string[]).map((item) => (
					<li>{item}</li>
				))}
			</ul>
			<p>{t('home.core3')}</p>
			<p>{t('home.core4')}</p>
			<p class="pull">{t('home.corePull')}</p>

			<h2>{t('home.lifeTitle')}</h2>
			<p>{t('home.life1')}</p>
			<p>{t('home.life2')}</p>
			<p>{t('home.life3')}</p>
			<ul>
				{(t('home.lifeList') as unknown as string[]).map((item) => (
					<li>{item}</li>
				))}
			</ul>
			<p>{t('home.life4')}</p>

			<h2>{t('home.findTitle')}</h2>
			<p>{t('home.find1')}</p>
			<p>{t('home.find2')}</p>
			<ul>
				{(t('home.findList') as unknown as string[]).map((item) => (
					<li>{item}</li>
				))}
			</ul>
			<p>{t('home.find3')}</p>
			<p>{t('home.find4')}</p>
			<p class="pull">{t('home.findPull')}</p>
		</div>

		{latestNotes.length > 0 && (
			<section class="recent-notes">
				<h2>{t('garden.recentNotes')}</h2>
				<div class="notes-list">
					{latestNotes.map((note) => (
						<a href={gardenNotePath(lang, slugFromNoteId(note.id))} class="note-link">
							<article class="note-item">
								<div class="note-item-header">
									<span class="note-item-title">{note.data.title}</span>
									<StatusBadge status={note.data.status} size="sm" />
								</div>
								<p class="note-item-description">{note.data.description}</p>
								<time class="note-item-date">
									{localeDateShort(note.data.created, lang)}
								</time>
							</article>
						</a>
					))}
				</div>
				<div class="garden-cta">
					<a href={localePath(lang, '/garden/')}>{t('nav.exploreGarden')}</a>
				</div>
			</section>
		)}

		<footer class="site-footer">
			<a href={localePath(lang, '/rss.xml')} class="rss-link" aria-label="RSS Feed">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
			</a>
			<p>{t('site.footer')}</p>
		</footer>
	</div>
</BaseLayout>


