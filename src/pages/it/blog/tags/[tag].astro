---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TopNav from '../../../../components/TopNav.astro';
import Footer from '../../../../components/Footer.astro';
import { getSortedPostsForLocale } from '../../../../lib/blog';
import { useTranslations, localePath, localeDateShort, slugFromNoteId } from '../../../../i18n/utils';
import type { Lang } from '../../../../i18n/ui';

export async function getStaticPaths() {
	const posts = await getSortedPostsForLocale('it');

	const tagSet = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags) {
			tagSet.add(tag);
		}
	}

	return Array.from(tagSet).map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((p) => p.data.tags.includes(tag))
				.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()),
		},
	}));
}

const { tag, posts } = Astro.props;
const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={`#${tag} — ${t('blog.title')} — ${t('site.title')}`} description={`${t('blog.postsTagged')} "${tag}"`}>
	<div class="container">
		<TopNav lang={lang} currentPath={Astro.url.pathname} />

		<header class="tag-header">
			<h1>#{tag}</h1>
			<p class="subtitle">{posts.length} {posts.length === 1 ? t('blog.post') : t('blog.posts')} {t('garden.withThisTag')}</p>
		</header>

		<div class="posts-list">
			{posts.map((post) => (
				<article class="post-row">
					<a href={localePath(lang, `/blog/${slugFromNoteId(post.id)}`)} class="post-title">{post.data.title}</a>
					<p class="post-desc">{post.data.description}</p>
					<span class="post-date">
						{localeDateShort(post.data.published, lang)}
					</span>
				</article>
			))}
		</div>

		<Footer lang={lang} />
	</div>
</BaseLayout>

<style>
	.container {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.tag-header {
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.tag-header h1 {
		font-size: 2rem;
		font-weight: 700;
		margin: 0 0 0.25rem 0;
		color: var(--color-text-primary);
		letter-spacing: -0.02em;
	}

	.subtitle {
		font-size: 0.95rem;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.post-row {
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-title {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.post-title:hover {
		color: var(--color-accent);
	}

	.post-desc {
		font-size: 0.9rem;
		color: var(--color-text-secondary);
		margin: 0.25rem 0;
		line-height: 1.5;
	}

	.post-date {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.7;
	}
</style>
