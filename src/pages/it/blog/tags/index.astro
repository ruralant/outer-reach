---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TopNav from '../../../../components/TopNav.astro';
import Footer from '../../../../components/Footer.astro';
import { getSortedPostsForLocale, getAllBlogTags } from '../../../../lib/blog';
import { useTranslations, localePath } from '../../../../i18n/utils';
import type { Lang } from '../../../../i18n/ui';

const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);

const posts = await getSortedPostsForLocale(lang);
const tags = getAllBlogTags(posts);
---

<BaseLayout title={`${t('tags.title')} — ${t('blog.title')} — ${t('site.title')}`} description={t('blog.tagsSubtitle') as string}>
	<div class="container">
		<TopNav lang={lang} currentPath={Astro.url.pathname} />

		<header class="tags-header">
			<h1>{t('tags.title')}</h1>
			<p class="subtitle">{t('blog.tagsSubtitle')}</p>
		</header>

		<ul class="tags-list">
			{tags.map((tag) => {
				const count = posts.filter((p) => p.data.tags.includes(tag)).length;
				return (
					<li><a href={localePath(lang, `/blog/tags/${tag}`)}>#{tag}</a> <span class="count">({count})</span></li>
				);
			})}
		</ul>

		<Footer lang={lang} />
	</div>
</BaseLayout>

<style>
	.container {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.tags-header {
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.tags-header h1 {
		font-size: 2rem;
		font-weight: 700;
		margin: 0 0 0.25rem 0;
		color: var(--color-text-primary);
		letter-spacing: -0.02em;
	}

	.subtitle {
		font-size: 1rem;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.tags-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.tags-list li {
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.tags-list a {
		color: var(--color-accent);
		text-decoration: none;
		font-size: 1.05rem;
	}

	.tags-list a:hover {
		text-decoration: underline;
	}

	.count {
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		opacity: 0.6;
	}
</style>
