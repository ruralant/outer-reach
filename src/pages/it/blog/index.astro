---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopNav from '../../../components/TopNav.astro';
import Footer from '../../../components/Footer.astro';
import { getSortedPostsForLocale, getAllBlogTags } from '../../../lib/blog';
import { useTranslations, localePath, localeDateShort, slugFromNoteId } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';

const lang = (Astro.currentLocale || 'it') as Lang;
const t = useTranslations(lang);

const posts = await getSortedPostsForLocale(lang);
const tags = getAllBlogTags(posts);
---

<BaseLayout title={`${t('blog.title')} — ${t('site.title')}`} description={t('blog.subtitle') as string}>
	<div class="blog-page">
		<TopNav lang={lang} currentPath={Astro.url.pathname} />

		<header class="blog-header">
			<h1>{t('blog.title')}</h1>
			<p class="subtitle">{t('blog.subtitle')}</p>
		</header>

		{tags.length > 0 && (
			<nav class="filter-nav">
				<div class="filter-row">
					<span class="filter-label">{t('garden.filterTags')}</span>
					<div class="filter-links">
						{tags.map((tag) => {
							const count = posts.filter((p) => p.data.tags.includes(tag)).length;
							return (
								<a href={localePath(lang, `/blog/tags/${tag}`)} class="filter-chip">
									{tag} <span class="chip-count">({count})</span>
								</a>
							);
						})}
					</div>
				</div>
			</nav>
		)}

		{posts.length === 0 ? (
			<p class="empty">{t('blog.noPosts')}</p>
		) : (
			<div class="posts-list">
				{posts.map((post) => (
					<a href={localePath(lang, `/blog/${slugFromNoteId(post.id)}`)} class="post-link">
						<article class="post-item">
							<div class="post-item-header">
								<span class="post-item-title">{post.data.title}</span>
							</div>
							<p class="post-item-description">{post.data.description}</p>
							<div class="post-item-footer">
								<time class="post-item-date">
									{localeDateShort(post.data.published, lang)}
								</time>
								{post.data.tags.length > 0 && (
									<span class="post-item-tags">
										{post.data.tags.join(' · ')}
									</span>
								)}
							</div>
						</article>
					</a>
				))}
			</div>
		)}

		<Footer lang={lang} />
	</div>
</BaseLayout>

<style>
	.blog-page {
		max-width: 640px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.blog-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.blog-header h1 {
		font-size: 2.8rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.75rem 0;
		color: var(--color-text-primary);
		line-height: 1.15;
	}

	.subtitle {
		font-size: 1.05rem;
		color: var(--color-text-secondary);
		margin: 0;
		line-height: 1.6;
	}

	/* --- Filter nav --- */
	.filter-nav {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.filter-row {
		margin-bottom: 0.75rem;
	}

	.filter-row:last-child {
		margin-bottom: 0;
	}

	.filter-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-secondary);
		margin-right: 0.75rem;
	}

	.filter-links {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.filter-chip {
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		text-decoration: none;
		padding: 0.15rem 0;
		transition: color 0.2s ease;
	}

	.filter-chip:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.filter-chip + .filter-chip::before {
		content: '·';
		margin-right: 0.4rem;
		color: var(--color-border);
	}

	.chip-count {
		font-size: 0.75rem;
		opacity: 0.6;
	}

	/* --- Posts list --- */
	.empty {
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.post-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.post-link:hover {
		text-decoration: none;
	}

	.post-item {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--color-border);
		transition: opacity 0.2s ease;
	}

	.post-link:first-child .post-item {
		padding-top: 0;
	}

	.post-link:hover .post-item {
		opacity: 0.7;
	}

	.post-item-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.3rem;
		flex-wrap: wrap;
	}

	.post-item-title {
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--color-text-primary);
		letter-spacing: -0.01em;
	}

	.post-item-description {
		font-size: 0.9rem;
		color: var(--color-text-secondary);
		margin: 0;
		line-height: 1.5;
	}

	.post-item-footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.4rem;
	}

	.post-item-date {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.7;
	}

	.post-item-tags {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.5;
	}

	@media (max-width: 640px) {
		.blog-header h1 {
			font-size: 2rem;
		}
	}
</style>
