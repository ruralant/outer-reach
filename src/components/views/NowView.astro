---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, localeDateString } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import { Content as NowEn } from "../../content/now/en.md";
import { Content as NowIt } from "../../content/now/it.md";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const Content = lang === "it" ? NowIt : NowEn;

// Bump when the now page content changes
const lastUpdated = new Date(Date.UTC(2026, 2, 1));
---

<BaseLayout title={`${t("now.title")} — ${t("site.title")}`}>
	<article class="now">
		<p class="eyebrow">{t("now.lastUpdated")}: {localeDateString(lastUpdated, lang, { month: "long", year: "numeric" })}</p>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.now {
		max-width: 42rem;
	}

	/* The markdown opens with "# Now" and a "## …" line under it: style them as the page header */
	.prose :global(h1:first-child) {
		margin-top: 1rem;
		font-family: var(--font-serif);
		font-size: 3rem;
		line-height: 1.05;
		letter-spacing: -0.025em;
		color: var(--color-ink);
	}

	.prose :global(h1:first-child + h2) {
		margin-top: 1.5rem;
		margin-bottom: 0;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-line);
		font-family: var(--font-sans);
		font-size: 1.25rem;
		line-height: 1.625;
		letter-spacing: 0;
		color: var(--color-ink-soft);
	}

	@media (min-width: 600px) {
		.prose :global(h1:first-child) {
			font-size: 4rem;
		}
	}
</style>
