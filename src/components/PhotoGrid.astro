---
import { Picture } from "astro:assets";
import type { Photo } from "../lib/photos";
import { localePath } from "../i18n/utils";

interface Props {
	photos: Photo[];
	lang: string;
	/** Columns below 600px; the homepage strip of three keeps 3 so no photo is left alone */
	mobileColumns?: 2 | 3;
}

const { photos, lang, mobileColumns = 2 } = Astro.props;
// Cell width in a 64rem container with three columns: (1024 - 2 * 32 - 2 * 16) / 3
const cell = 310;
---

<ul class="grid" style={`--mobile-cols: ${mobileColumns}`}>
	{photos.map((photo, i) => (
		<li>
			<a href={localePath(lang, `/photos/${photo.slug}`)}>
				<Picture
					src={photo.image}
					alt={photo.slug}
					width={cell}
					height={cell}
					widths={[cell, cell * 2]}
					sizes={`(max-width: 599px) ${mobileColumns === 3 ? 31 : 46}vw, ${cell}px`}
					formats={["avif"]}
					fallbackFormat="webp"
					loading={i === 0 ? "eager" : "lazy"}
					fetchpriority={i === 0 ? "high" : "auto"}
					decoding="async"
				/>
			</a>
		</li>
	))}
</ul>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(var(--mobile-cols), minmax(0, 1fr));
		gap: 0.75rem;
	}

	@media (min-width: 600px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
		}
	}

	a {
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 0.75rem;
		background-color: var(--color-surface);
	}

	a :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	a:hover :global(img) {
		scale: 1.03;
	}
</style>
