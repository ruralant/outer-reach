---
interface Props {
	label: string;
	href?: string;
	count?: number;
}

const { label, href, count } = Astro.props;
---

{href ? (
	<a class="tag tag-link" href={href}>{label}{count !== undefined && <span class="count">{count}</span>}<slot /></a>
) : (
	<span class="tag">{label}<slot /></span>
)}

<style>
	.tag {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--color-line);
		border-radius: 9999px;
		font-size: 0.75rem;
		line-height: 1.25rem;
		color: var(--color-muted);
		white-space: nowrap;
	}

	.tag-link {
		transition: border-color 150ms, color 150ms;
	}

	.tag-link:hover {
		border-color: var(--color-ink);
		color: var(--color-ink);
	}

	.count {
		font-variant-numeric: tabular-nums;
		opacity: 0.7;
	}
</style>
