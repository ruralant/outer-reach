---
import type { NoteStatus } from "../lib/garden";
import { useTranslations, localePath } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
	status: NoteStatus;
	/** Links to the status page when set */
	link?: boolean;
	count?: number;
}

const { status, link = false, count } = Astro.props;
const lang = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(lang);

const label = t(`status.${status}`) as string;
const description = t(`status.${status}.description`) as string;
const Tag = link ? "a" : "span";
---

<Tag
	class:list={["status", { "status-link": link }]}
	style={`--dot: var(--color-${status})`}
	href={link ? localePath(lang, `/garden/status/${status}`) : undefined}
	title={description}
>
	<span class="dot" aria-hidden="true"></span>
	{label}
	{count !== undefined && <span class="count">{count}</span>}
</Tag>

<style>
	.status {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.125rem 0.625rem 0.125rem 0.5rem;
		border: 1px solid var(--color-line);
		border-radius: 9999px;
		font-size: 0.75rem;
		line-height: 1.25rem;
		color: var(--color-ink-soft);
		white-space: nowrap;
	}

	.dot {
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: 50%;
		background-color: var(--dot);
	}

	.status-link {
		transition: border-color 150ms, color 150ms;
	}

	.status-link:hover {
		border-color: var(--color-ink);
		color: var(--color-ink);
	}

	.count {
		font-variant-numeric: tabular-nums;
		color: var(--color-muted);
	}
</style>
