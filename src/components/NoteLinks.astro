---
import StatusBadge from "./StatusBadge.astro";
import type { GardenNote } from "../lib/garden";
import { gardenNotePath, slugFromNoteId } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
	/** Section heading, e.g. "Related notes" or "Linked from" */
	title: string;
	notes: GardenNote[];
}

const { title, notes } = Astro.props;
const lang = (Astro.currentLocale || "en") as Lang;
---

{notes.length > 0 && (
	<section class="note-links">
		<h2 class="eyebrow">{title}</h2>
		<ul>
			{notes.map((note) => (
				<li>
					<a href={gardenNotePath(lang, slugFromNoteId(note.id))}>{note.data.title}</a>
					<StatusBadge status={note.data.status} />
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.note-links {
		margin-top: 4rem;
	}

	ul {
		margin-top: 1rem;
		border-bottom: 1px solid var(--color-line);
	}

	li {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding-block: 1rem;
		border-top: 1px solid var(--color-line);
	}

	a {
		font-family: var(--font-serif);
		font-size: 1.375rem;
		line-height: 1.2;
		letter-spacing: var(--tracking-title);
		color: var(--color-ink);
		text-decoration-color: color-mix(in oklab, var(--color-accent) 60%, transparent);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	li:hover a {
		text-decoration-line: underline;
	}
</style>
