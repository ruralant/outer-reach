---
import { languages, type Lang } from '../i18n/ui';
import { getAlternateLocaleUrl } from '../i18n/utils';

const currentLang = (Astro.currentLocale || 'en') as Lang;
const alternateUrl = getAlternateLocaleUrl(Astro.url, currentLang);
const targetLang: Lang = currentLang === 'en' ? 'it' : 'en';
---

<a href={alternateUrl} class="lang-switch" aria-label={languages[targetLang]}>
	{targetLang.toUpperCase()}
</a>

<style>
	.lang-switch {
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.lang-switch:hover {
		color: var(--color-accent);
		text-decoration: none;
	}
</style>
