---
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const version: string = __APP_VERSION__;
---

<footer class="site-footer">
	<a href={localePath(lang, '/rss.xml')} class="rss-link" aria-label="RSS Feed">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 11a9 9 0 0 1 9 9"></path>
			<path d="M4 4a16 16 0 0 1 16 16"></path>
			<circle cx="5" cy="19" r="1"></circle>
		</svg>
	</a>
	<p>{t('site.footer')}</p>
	<div class="site-version">v{version}</div>
</footer>

<style is:global>
	footer.site-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
		text-align: center;
	}

	footer.site-footer .rss-link {
		display: inline-flex;
		color: var(--color-text-secondary);
		opacity: 0.5;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	footer.site-footer .rss-link:hover {
		opacity: 1;
		color: var(--color-accent);
		text-decoration: none;
	}

	footer.site-footer p {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		opacity: 0.6;
		margin-top: 0.75rem;
		margin-bottom: 0;
	}

	footer.site-footer .site-version {
		font-size: 0.65rem;
		color: var(--color-text-secondary);
		opacity: 0.4;
		margin-top: 1rem;
		user-select: none;
	}
</style>
