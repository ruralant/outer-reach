---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { navigation } from "../lib/navigation";
import { useTranslations, localePath } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const lang = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(lang);
const version: string = __APP_VERSION__;
const year = new Date().getFullYear();

// Static Website Carbon figures — re-test and update when page weight changes.
// Quick estimate from a build's homepage bytes, before deploying:
//   curl "https://api.websitecarbon.com/data?bytes=<bytes>&green=0"
const carbon = {
	url: "https://www.websitecarbon.com/website/outerreach-life/",
	grams: "0.01",
	cleanerThan: 98,
};
---

<footer class="site-footer container">
	<div class="main">
		<div>
			<p class="brand">Outer Reach</p>
			<p class="blurb">{t("site.tagline")}</p>
			<a class="carbon" href={carbon.url} target="_blank" rel="noopener noreferrer">
				<span class="carbon-value">{carbon.grams} g CO<sub>2</sub>{t("footer.carbon.perView")}</span>
				<span class="carbon-label">Website Carbon<span aria-hidden="true"> ↗</span></span>
			</a>
			<p class="carbon-detail">{String(t("footer.carbon.cleaner")).replace("{pct}", String(carbon.cleanerThan))}</p>
		</div>

		<div class="columns">
			<nav aria-label={t("footer.site") as string}>
				<p class="eyebrow">{t("footer.site")}</p>
				<ul>
					<li><a href={localePath(lang, "/")}>{t("nav.home")}</a></li>
					{navigation.map((item) => (
						<li><a href={localePath(lang, item.path)}>{t(item.key)}</a></li>
					))}
				</ul>
			</nav>
			<nav aria-label={t("footer.elsewhere") as string}>
				<p class="eyebrow">{t("footer.elsewhere")}</p>
				<ul>
					<li><a href={localePath(lang, "/manifesto/")}>Manifesto</a></li>
					<li><a href={localePath(lang, "/rss.xml")}>{t("footer.rss")}</a></li>
					<li><LanguageSwitcher variant="name" /></li>
				</ul>
			</nav>
		</div>
	</div>

	<div class="bottom">
		<p>© 2025–{year} Outer Reach</p>
		<p>v{version}</p>
	</div>
</footer>

<style>
	.main {
		display: grid;
		gap: 2.5rem;
		padding-top: 3rem;
		padding-bottom: 2.5rem;
		border-top: 1px solid var(--color-line);
	}

	@media (min-width: 800px) {
		.main {
			grid-template-columns: 1fr auto;
		}
	}

	.brand {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		line-height: 1;
		letter-spacing: var(--tracking-title);
	}

	.blurb {
		max-width: 20rem;
		margin-top: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.carbon {
		display: inline-flex;
		align-items: stretch;
		margin-top: 1.5rem;
		overflow: hidden;
		border: 1px solid var(--color-line-strong);
		border-radius: 9999px;
		font-size: 0.75rem;
		line-height: 1;
		transition: border-color 150ms;
	}

	.carbon:hover {
		border-color: var(--color-ink);
	}

	.carbon-value,
	.carbon-label {
		padding: 0.5rem 0.75rem;
	}

	.carbon-value {
		font-variant-numeric: tabular-nums;
		color: var(--color-ink-soft);
	}

	.carbon-value sub {
		font-size: 0.75em;
		line-height: 0;
	}

	.carbon-label {
		border-left: 1px solid var(--color-line-strong);
		background-color: var(--color-surface);
		font-weight: 500;
		color: var(--color-ink);
		transition: border-color 150ms, color 150ms;
	}

	.carbon:hover .carbon-label {
		border-color: var(--color-ink);
		color: var(--color-accent);
	}

	.carbon-detail {
		margin-top: 0.5rem;
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.columns {
		display: grid;
		grid-template-columns: repeat(2, auto);
		justify-content: start;
		gap: 2rem 4rem;
		font-size: 0.875rem;
	}

	.columns ul {
		display: grid;
		gap: 0.625rem;
		margin-top: 1rem;
	}

	.columns :global(a) {
		color: var(--color-ink-soft);
		transition: color 150ms;
	}

	.columns :global(a:hover) {
		color: var(--color-accent);
	}

	.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-bottom: 2.5rem;
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		color: var(--color-muted);
	}
</style>
