---
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const version: string = __APP_VERSION__;

// Static Website Carbon figures — re-test and update when page weight changes.
const carbon = {
	url: 'https://www.websitecarbon.com/website/outerreach-life/',
	grams: '0.04',
	cleanerThan: 89,
};
---

<footer class="site-footer">
	<a href={localePath(lang, '/rss.xml')} class="rss-link" aria-label="RSS Feed">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 11a9 9 0 0 1 9 9"></path>
			<path d="M4 4a16 16 0 0 1 16 16"></path>
			<circle cx="5" cy="19" r="1"></circle>
		</svg>
	</a>
	<p>{t('site.footer')}</p>
	<div class="carbon">
		<a href={carbon.url} target="_blank" rel="noopener noreferrer" class="carbon-badge">
			<span class="carbon-badge__value">{carbon.grams}g CO<sub>2</sub>{t('footer.carbon.perView')}</span><span class="carbon-badge__label">Website Carbon</span>
		</a>
		<a href={carbon.url} target="_blank" rel="noopener noreferrer" class="carbon-badge__detail">
			{String(t('footer.carbon.cleaner')).replace('{pct}', String(carbon.cleanerThan))}
		</a>
	</div>
	<div class="site-version">v{version}</div>
</footer>

<style is:global>
	footer.site-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
		text-align: center;
	}

	footer.site-footer .rss-link {
		display: inline-flex;
		color: var(--color-text-secondary);
		opacity: 0.5;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	footer.site-footer .rss-link:hover {
		opacity: 1;
		color: var(--color-accent);
		text-decoration: none;
	}

	footer.site-footer p {
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		margin-top: 0.75rem;
		margin-bottom: 0;
	}

	footer.site-footer .carbon {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1rem;
	}

	footer.site-footer .carbon-badge {
		--carbon-label: var(--color-accent-dark);
		display: inline-flex;
		font-size: 0.7rem;
		line-height: 1;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	[data-theme='dark'] footer.site-footer .carbon-badge {
		--carbon-label: var(--color-accent);
	}

	footer.site-footer .carbon-badge__value,
	footer.site-footer .carbon-badge__label {
		display: inline-flex;
		align-items: center;
		padding: 0.4em 0.65em;
	}

	footer.site-footer .carbon-badge__value {
		border: 1px solid var(--color-border);
		border-right: 0;
		border-radius: 4px 0 0 4px;
		color: var(--color-text-secondary);
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	footer.site-footer .carbon-badge__value sub {
		font-size: 0.75em;
		vertical-align: baseline;
		position: relative;
		top: 0.25em;
	}

	footer.site-footer .carbon-badge__label {
		border: 1px solid var(--carbon-label);
		border-radius: 0 4px 4px 0;
		background: var(--carbon-label);
		color: var(--color-background);
		font-weight: 600;
	}

	footer.site-footer .carbon-badge:hover .carbon-badge__value {
		color: var(--color-text-primary);
		border-color: var(--carbon-label);
	}

	footer.site-footer .carbon-badge__detail {
		font-size: 0.7rem;
		color: var(--color-text-secondary);
		transition: color 0.2s ease;
	}

	footer.site-footer .carbon-badge__detail:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	footer.site-footer .site-version {
		font-size: 0.65rem;
		color: var(--color-text-secondary);
		margin-top: 1rem;
		user-select: none;
	}
</style>
