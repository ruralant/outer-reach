---
interface Props {
	eyebrow: string;
	/** Plain-text title; use the `title` slot instead for markup */
	title?: string;
}

const { eyebrow, title } = Astro.props;
---

<header class="page-header">
	<p class="eyebrow">{eyebrow}</p>
	<h1>{title}<slot name="title" /></h1>
	{Astro.slots.has("default") && (
		<div class="lede"><slot /></div>
	)}
</header>

<style>
	.page-header {
		max-width: 48rem;
		padding-bottom: 3rem;
	}

	h1 {
		margin-top: 1rem;
		font-family: var(--font-serif);
		font-size: 3rem;
		line-height: 1.05;
		letter-spacing: -0.025em;
		text-wrap: balance;
		color: var(--color-ink);
	}

	.lede {
		max-width: 42rem;
		margin-top: 1.5rem;
		font-size: 1.125rem;
		line-height: 1.625;
		text-wrap: pretty;
		color: var(--color-ink-soft);
	}

	@media (min-width: 600px) {
		h1 {
			font-size: 4rem;
		}

		.lede {
			font-size: 1.25rem;
		}
	}

	@media (min-width: 800px) {
		.page-header {
			padding-bottom: 4rem;
		}
	}
</style>
